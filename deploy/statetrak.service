[Unit]
Description=StateTrak CS2 demo viewer
After=network.target

[Service]
User=statetrak
Group=statetrak
WorkingDirectory=/opt/statetrak
Environment=GIN_MODE=release
# .env: TYPESAFE_API_KEY (JEV analysis) and optionally
#       UPLOAD_MAX_BYTES, PARSE_CONCURRENCY, ALLOWED_ORIGIN
# .env is dash-prefixed so a missing file doesn't block startup
# (the app runs fine without it; only JEV analysis needs the key).
EnvironmentFile=-/opt/statetrak/.env
ExecStart=/opt/statetrak/statetrak
Restart=on-failure

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/statetrak/controllers/data

[Install]
WantedBy=multi-user.target